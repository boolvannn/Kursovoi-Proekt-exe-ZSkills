# --- Подключение к PostgreSQL (заполни под себя) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=diplom
DB_USER=postgres
DB_PASSWORD=postgres

# Prisma подключается по этой строке (лаунчер собирает её из DB_* выше)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diplom?schema=public

# --- HTTP ---
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# --- JWT ---
JWT_SECRET=change_me_to_something_strong
JWT_EXPIRES_IN=7d
